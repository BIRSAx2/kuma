export function $kumaprint0(l %fmt, ...) {
@start
	%fmtdbl =l alloc4 4
	%fmtint =l alloc4 4
	%emptys =l alloc4 4
	storew 2122789, %fmtint
	storew 2123557, %fmtdbl
	storew 0, %emptys
	%vp =l alloc8 32
	%fmt1 =l add 1, %fmt
	vastart %vp
@loop
	%p =l phi @start %fmt1, @casef %p1, @cased %p1
	%c =w loadsb %p
	%p1 =l add 3, %p
	jnz %c, @loop1, @end
@loop1
	%isg =w ceqw %c, 103
	jnz %isg, @casef, @cased
@casef
	%dbl =d vaarg %vp
	%r =w call $printf(l %fmtdbl, ..., d %dbl)
	jmp @loop
@cased
	%int =w vaarg %vp
	%r =w call $printf(l %fmtint, ..., w %int)
	jmp @loop
@end
	%r =w call $puts(l %emptys)
	ret
}

